# Required secrets
GEMINI_API_KEY=your-gemini-api-key
ASSISTANT_INTERNAL_KEY=replace-with-a-private-shared-key
JWT_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_PASSWORD=choose-a-strong-password

# Seeded administrator username
ADMIN_USERNAME=admin

# Optional model and service settings
GEMINI_MODEL=gemini-3.6-flash
GEMINI_API_VERSION=v1beta
EMBEDDING_MODEL=gemini-embedding-001
LOG_LEVEL=INFO

# Browser-visible URLs. These are the defaults for the local Compose stack.
VITE_API_BASE_URL=http://localhost:5090
FRONTEND_ORIGIN=http://localhost:5173

# Optional JWT metadata
JWT_ISSUER=KnowledgeAssistantWebAPI
JWT_AUDIENCE=KnowledgeAssistantApp
